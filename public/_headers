# Cloudflare 用のレスポンスヘッダ設定(vercel.json と同等の内容)。
# public/ に置くと Vite がビルド時に dist/ へコピーし、Cloudflare が読み取る
# (Pages / Workers の静的アセットどちらでも有効)。
# ※ Vercel はこのファイルを無視し、vercel.json を使う(両対応)。

# Service Worker は毎回検証させ、更新を確実に伝播させる
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache

# ハッシュ付きアセットは長期の不変キャッシュ
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 自己ホストしたフォント。ファイル名にハッシュが付かない(生成手順の都合)ので
# immutable にはせず、30日で再検証させる。差し替えるのはフォントの版を
# 上げるときだけ。
/fonts/*
  Cache-Control: public, max-age=2592000

# 全ページ共通のセキュリティヘッダ
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  # microphone=(self) はボイスプロフィールの録音に必要(このサイト自身のみ許可)。
  # microphone=() にすると Chrome のサイト設定で許可しても
  # "Permissions policy violation" で録音できなくなる。
  Permissions-Policy: geolocation=(), microphone=(self), camera=()
  # HTTPSに固定する。1年 + サブドメイン。**preload は入れていない**
  # (プリロードリストは事実上取り消せず、将来サブドメインでHTTPを使えなくなる)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # CSP: 差し込まれたスクリプトが動かないように、読み込み元を絞る。
  #   script-src 'self'  … インラインスクリプトを禁じる(Viteはバンドルを外部ファイルで出す)
  #   style-src に 'unsafe-inline' … Reactのstyle属性のために必要。
  #     このアプリはCSS-in-JS(style属性)で全画面を組んでいるので外せない
  #   ⚠️ **fonts.googleapis.com / fonts.gstatic.com は意図的に外してある。**
  #     フォントは自己ホストに切り替えた(弁護士回答Q20・外部送信規律)。
  #     ここに戻すと、外部読み込みに戻す変更をCSPが素通ししてしまう
  #   connect-src … Supabase(REST/Realtime/Storage/Functions)への接続を許す。
  #     wss: はRealtime(通知の即時反映)に必要
  #   frame-ancestors 'none' … 埋め込み禁止(X-Frame-Options より新しい規定)
  #   form-action 'self' … 差し込まれたフォームで外部へ送信させない
  # ⚠️ Stripeの決済ページへは window.location.href で遷移する(iframeではない)ので
  #    frame-src は要らない。将来Stripe Elementsを埋め込むなら追加すること。
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.supabase.co; media-src 'self' blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
